import java.util.Scanner;

class Queue {
    int front = -1, rear = -1;
    int size = 5;
    int[] arr = new int[size];

    // Enqueue - Peeche se daalna
    void enqueue(int x) {
        if (rear == size - 1) {
            System.out.println("Queue Overflow! Queue full hai.");
        } else {
            if (front == -1) front = 0;
            rear++;
            arr[rear] = x;
            System.out.println(x + " enqueue .");
        }
    }

    
    void dequeue() {
        if (front == -1 || front > rear) {
            System.out.println("Queue Underflow! Queue khali hai.");
        } else {
            System.out.println(arr[front] + " dequeue ho gaya.");
            front++;
        }
    }

    
    void frontElement() {
        if (front == -1 || front > rear) {
            System.out.println("Queue khali hai.");
        } else {
            System.out.println("Front element: " + arr[front]);
        }
    }

    
    void display() {
        if (front == -1 || front > rear) {
            System.out.println("Queue empty");
        } else {
            System.out.println("Queue elements:");
            for (int i = front; i <= rear; i++) {
                System.out.print(arr[i] + " ");
            }
            System.out.println();
        }
    }
}

public class Main2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Queue q = new Queue();
        int choice, value;

        while (true) {
            System.out.println("\n1.Enqueue  2.Dequeue  3.Front  4.Display  5.Exit");
            System.out.print("Choice: ");
            choice = sc.nextInt();

            if (choice == 1) {
                System.out.print("Value daalo: ");
                value = sc.nextInt();
                q.enqueue(value);
            } else if (choice == 2) {
                q.dequeue();
            } else if (choice == 3) {
                q.frontElement();
            } else if (choice == 4) {
                q.display();
            } else if (choice == 5) {
                break;
            }
        }
    }
}