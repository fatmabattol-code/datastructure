import java.util.Scanner;

class Stack {
    int top = -1;
    int size = 5;
    int[] arr = new int[size];

    
    void push(int x) {
        if (top == size - 1) {
            System.out.println("Stack Overflow! .");
        } else {
            top++;
            arr[top] = x;
            System.out.println(x + " push ");
        }
    }

    // Pop - Element nikalna
    void pop() {
        if (top == -1) {
            System.out.println("Stack Underflow!.");
        } else {
            System.out.println(arr[top] + " poped");
            top--;
        }
    }

    
    void peek() {
        if (top == -1) {
            System.out.println("Stack is empty");
        } else {
            System.out.println("Top element: " + arr[top]);
        }
    }

    // Display - Sab dikhana
    void display() {
        if (top == -1) {
            System.out.println("Stack is empty.");
        } else {
            System.out.println("Stack elements :");
            for (int i = top; i >= 0; i--) {
                System.out.println(arr[i]);
            }
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Stack s = new Stack();
        int choice, value;

        while (true) {
            System.out.println("\n1.Push  2.Pop  3.Peek  4.Display  5.Exit");
            System.out.print("Choice: ");
            choice = sc.nextInt();

            if (choice == 1) {
                System.out.print("Value daalo: ");
                value = sc.nextInt();
                s.push(value);
            } else if (choice == 2) {
                s.pop();
            } else if (choice == 3) {
                s.peek();
            } else if (choice == 4) {
                s.display();
            } else if (choice == 5) {
                break;
            }
        }
    }
}

